{
    "sourceRoot": "force-app/main/default",
    "salesforceMetadata": [
        {
            "type": "AiAuthoringBundle",
            "description": "Agent Script bundle defining an Agentforce agent and its associated metadata",
            "directory": "aiAuthoringBundles",
            "isBundle": true,
            "files": [
                {
                    "extension": ".agent",
                    "fileType": "code",
                    "consumes": [
                        {
                            "targetType": "Bot",
                            "relationship": "targetAgent",
                            "pattern": "agent_name\\s*=\\s*\"(?P<target>\\w+)\""
                        },
                        {
                            "targetType": "GenAiPlannerBundle",
                            "relationship": "planner",
                            "pattern": "planner\\s*=\\s*(?P<target>\\w+)"
                        },
                        {
                            "targetType": "GenAiPlugin",
                            "relationship": "topic",
                            "pattern": "topic\\s+(?P<target>\\w+)"
                        },
                        {
                            "targetType": "GenAiFunction",
                            "relationship": "action",
                            "pattern": "action\\s+(?P<target>\\w+)"
                        },
                        {
                            "targetType": "GenAiPromptTemplate",
                            "relationship": "promptTemplate",
                            "pattern": "prompt_template\\s*=\\s*(?P<target>\\w+)"
                        },
                        {
                            "targetType": "Flow",
                            "relationship": "invocationTarget",
                            "pattern": "flow\\s*=\\s*(?P<target>\\w+)"
                        },
                        {
                            "targetType": "ApexClass",
                            "relationship": "invocationTarget",
                            "pattern": "apex_class\\s*=\\s*(?P<target>\\w+)"
                        }
                    ],
                    "provides": [
                        {
                            "relationship": "AgentDefinition"
                        }
                    ]
                },
                {
                    "extension": ".bundle-meta.xml",
                    "fileType": "xml"
                }
            ]
        },
        {
            "type": "AuraComponentBundle",
            "description": "Aura component bundle for Lightning Experience, Experience Cloud and Visualforce integration",
            "directory": "aura",
            "isBundle": true,
            "files": [
                {
                    "extension": ".cmp",
                    "fileType": "xml",
                    "consumes": [
                        {
                            "targetType": "LightningComponentBundle",
                            "relationship": "LwcDependency",
                            "pattern": "c:(?P<target>\\w+)"
                        },
                        {
                            "targetType": "AuraComponentBundle",
                            "relationship": "AuraDependency",
                            "pattern": "c:(?P<target>\\w+)"
                        },
                        {
                            "targetType": "Flow",
                            "relationship": "FlowEmbedding",
                            "pattern": "lightning:flow"
                        }
                    ],
                    "provides": [
                        {
                            "relationship": "AuraEnabledComponent"
                        },
                        {
                            "relationship": "LwcContainer"
                        }
                    ]
                },
                {
                    "extension": "Controller.js",
                    "fileType": "code",
                    "consumes": [
                        {
                            "targetType": "ApexClass",
                            "relationship": "AuraEnabledMethodCall",
                            "pattern": "c\\.(?P<target>\\w+)"
                        }
                    ]
                },
                {
                    "extension": "Helper.js",
                    "fileType": "code",
                    "consumes": [
                        {
                            "targetType": "ApexClass",
                            "relationship": "AuraEnabledMethodCall",
                            "pattern": "c\\.(?P<target>\\w+)"
                        }
                    ]
                },
                {
                    "extension": ".js-meta.xml",
                    "fileType": "xml"
                }
            ],
            "provides": [
                {
                    "relationship": "VisualforceEmbedding",
                    "pattern": "\\$Lightning\\.use"
                }
            ]
        },
        {
            "type": "ApexClass",
            "description": "Apex backend code/logic",
            "directory": "classes",
            "extension": ".cls",
            "fileType": "code",
            "hasMetaFile": true,
            "naming": "{class_name}.cls",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "staticMethodInvocation",
                    "pattern": "(?P<target>\\w+)\\.\\w+\\("
                },
                {
                    "targetType": "ApexClass",
                    "relationship": "enqueueJob",
                    "pattern": "System\\.enqueueJob\\(new\\s+(?P<target>\\w+)"
                },
                {
                    "targetType": "ApexClass",
                    "relationship": "executeBatch",
                    "pattern": "Database\\.executeBatch\\(new\\s+(?P<target>\\w+)"
                },
                {
                    "targetType": "ApexClass",
                    "relationship": "schedule",
                    "pattern": "System\\.schedule\\([^,]+,\\s*new\\s+(?P<target>\\w+)"
                }
            ],
            "provides": [
                {
                    "relationship": "InvocableMethod",
                    "scope": "method",
                    "pattern": "@InvocableMethod"
                },
                {
                    "relationship": "AuraEnabled",
                    "scope": "method",
                    "pattern": "@AuraEnabled"
                },
                {
                    "relationship": "FutureMethod",
                    "scope": "method",
                    "pattern": "@future"
                },
                {
                    "relationship": "RemoteAction",
                    "scope": "method",
                    "pattern": "@RemoteAction"
                },
                {
                    "relationship": "Continuation",
                    "scope": "method",
                    "pattern": "@AuraEnabled\\(continuation\\s*=\\s*true\\)"
                },
                {
                    "relationship": "TestVisible",
                    "scope": "method",
                    "pattern": "@TestVisible"
                },
                {
                    "relationship": "RestResource",
                    "scope": "class",
                    "pattern": "@RestResource"
                },
                {
                    "relationship": "Queueable",
                    "scope": "class",
                    "pattern": "implements\\s+Queueable"
                },
                {
                    "relationship": "Batchable",
                    "scope": "class",
                    "pattern": "implements\\s+Database\\.Batchable"
                },
                {
                    "relationship": "Schedulable",
                    "scope": "class",
                    "pattern": "implements\\s+Schedulable"
                }
            ]
        },
        {
            "type": "ApexPage",
            "description": "Visualforce UI page",
            "directory": "pages",
            "extension": ".page",
            "fileType": "xml",
            "hasMetaFile": true,
            "naming": "{page_name}.page",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "controller",
                    "pattern": "controller=\"(?P<target>[^\"]+)\"",
                    "required": true
                },
                {
                    "targetType": "ApexClass",
                    "relationship": "extension",
                    "pattern": "extensions=\"(?P<target>[^\"]+)\""
                },
                {
                    "targetType": "AuraComponentBundle",
                    "relationship": "LightningOut",
                    "pattern": "<apex:includeLightning"
                }
            ]
        },
        {
            "type": "ApexTrigger",
            "description": "Database DML automation trigger",
            "directory": "triggers",
            "extension": ".trigger",
            "fileType": "code",
            "hasMetaFile": true,
            "naming": "{trigger_name}.trigger",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "staticMethodInvocation",
                    "pattern": "(?P<target>\\w+)\\.\\w+\\("
                }
            ]
        },
        {
            "type": "Bot",
            "description": "Top-level Agentforce Agent runtime",
            "directory": "bots",
            "extension": ".bot-meta.xml",
            "fileType": "xml",
            "naming": "{bot_name}.bot-meta.xml"
        },
        {
            "type": "BotVersion",
            "description": "Versioned Agent runtime config",
            "directory": "bots",
            "extension": ".botVersion-meta.xml",
            "fileType": "xml",
            "naming": "{bot_name}.{version_number}.botVersion-meta.xml",
            "parentType": "Bot"
        },
        {
            "type": "Flow",
            "description": "Automation, orchestration, agent action, and prompt data provider",
            "directory": "flows",
            "extension": ".flow-meta.xml",
            "fileType": "xml",
            "naming": "{flow_name}.flow-meta.xml",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "InvocableMethod",
                    "pattern": "<apexClass>(?P<target>\\w+)</apexClass>"
                },
                {
                    "targetType": "Flow",
                    "relationship": "Subflow",
                    "pattern": "<flowName>(?P<target>\\w+)</flowName>"
                },
                {
                    "targetType": "GenAiPromptTemplate",
                    "relationship": "PromptTemplate",
                    "pattern": "<promptTemplate>(?P<target>\\w+)</promptTemplate>"
                },
                {
                    "targetType": "GenAiFunction",
                    "relationship": "AgentAction",
                    "pattern": "<actionName>(?P<target>\\w+)</actionName>"
                },
                {
                    "targetType": "LightningComponentBundle",
                    "relationship": "ScreenComponent",
                    "pattern": "<extensionName>c:(?P<target>\\w+)</extensionName>"
                }
            ],
            "provides": [
                {
                    "relationship": "Subflow"
                },
                {
                    "relationship": "DataProvider"
                }
            ]
        },
        {
            "type": "GenAiFunction",
            "description": "Agent Action invoking Apex, Flows, or Prompts",
            "directory": "genAiFunctions",
            "extension": ".genAiFunction-meta.xml",
            "fileType": "xml",
            "naming": "{function_name}.genAiFunction-meta.xml",
            "parentType": "GenAiPlugin",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "invocationTarget",
                    "pattern": "<invocationTarget>(?P<target>\\w+)</invocationTarget>"
                },
                {
                    "targetType": "Flow",
                    "relationship": "invocationTarget",
                    "pattern": "<invocationTarget>(?P<target>\\w+)</invocationTarget>"
                },
                {
                    "targetType": "GenAiPromptTemplate",
                    "relationship": "invocationTarget",
                    "pattern": "<invocationTarget>(?P<target>\\w+)</invocationTarget>"
                }
            ]
        },
        {
            "type": "GenAiPlannerBundle",
            "description": "Orchestration brain linking Functions and Plugins",
            "directory": "genAiPlannerBundles",
            "extension": ".genAiPlannerBundle-meta.xml",
            "fileType": "xml",
            "parentType": "BotVersion",
            "consumes": [
                {
                    "targetType": "GenAiPlugin",
                    "relationship": "subagentTopic",
                    "pattern": "<pluginName>(?P<target>\\w+)</pluginName>"
                }
            ]
        },
        {
            "type": "GenAiPlugin",
            "description": "Subagent or topic conversation scope",
            "directory": "genAiPlugins",
            "extension": ".genAiPlugin-meta.xml",
            "fileType": "xml",
            "parentType": "GenAiPlannerBundle",
            "consumes": [
                {
                    "targetType": "GenAiFunction",
                    "relationship": "topicAction",
                    "pattern": "<functionName>(?P<target>\\w+)</functionName>"
                }
            ]
        },
        {
            "type": "GenAiPromptTemplate",
            "description": "Reusable AI prompt layout via Prompt Builder",
            "directory": "genAiPromptTemplates",
            "extension": ".genAiPromptTemplate-meta.xml",
            "fileType": "xml",
            "naming": "{prompt_name}.genAiPromptTemplate-meta.xml",
            "consumes": [
                {
                    "targetType": "ApexClass",
                    "relationship": "DataProvider",
                    "pattern": "\\{!Apex:(?P<target>\\w+)\\.\\w+\\}"
                },
                {
                    "targetType": "Flow",
                    "relationship": "DataProvider",
                    "pattern": "\\{!Flow:(?P<target>\\w+)\\}"
                }
            ]
        },
        {
            "type": "LightningComponentBundle",
            "description": "LWC UI layout rendering bundle",
            "directory": "lwc",
            "isBundle": true,
            "files": [
                {
                    "extension": ".js",
                    "fileType": "code",
                    "consumes": [
                        {
                            "targetType": "ApexClass",
                            "relationship": "apexMethodImport",
                            "pattern": "@salesforce/apex/(?P<target>\\w+)\\.\\w+"
                        }
                    ]
                },
                {
                    "extension": ".html",
                    "fileType": "xml"
                },
                {
                    "extension": ".css",
                    "fileType": "xml"
                }
            ]
        }
    ]
}